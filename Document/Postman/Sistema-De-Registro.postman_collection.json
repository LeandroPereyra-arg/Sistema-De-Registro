				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// --> Test comun a todos los request",
					"pm.test(\"Responde en menos de 2 segundos\", () => pm.expect(pm.response.responseTime).to.be.below(2000));",
					"pm.test(\"Responde JSON\", () => pm.response.to.be.json);"
				]
			}
		}
