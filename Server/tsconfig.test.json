{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "..",
    "noEmit": true,
    "typeRoots": ["./node_modules/@types"],
    "types": ["jest", "node"],
    "paths": { "*": ["./node_modules/*", "./node_modules/@types/*"] }
  },
  "include": ["src/**/*", "../Document/Backend/**/*"]
}
